NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Gym Assistant"
NEXT_PUBLIC_APP_VERSION="0.1.0"
DATA_DIR=./data
NEXT_PUBLIC_GYMLEAD_GYMLEADSUPABASE_URL=
NEXT_PUBLIC_GYMLEAD_GYMLEADSUPABASE_PUBLISHABLE_KEY=
GYMLEAD_SUPABASE_SERVICE_ROLE_KEY=
GYMLEAD_POSTGRES_URL=
# Correo (ver README, sección Correo, y Doc/CORREO_DOMINIO.md):
# CORREO_PROVEEDOR: gmail, resend o auto (por defecto). En auto se usa Resend si RESEND_FROM es de un dominio
#   propio y hay RESEND_API_KEY; si no, Gmail. Si el primero falla antes de aceptar el correo, se prueba el otro.
# RESEND_FROM: "Gym Assistant <no-responder@midominio.com>" (con un dominio verificado en Resend).
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM=
CORREO_PROVEEDOR=
# CHRONO: clave de Groq, modelo opcional y límite opcional de mensajes por cuenta y día.
GROQ_API_KEY=
GROQ_MODELO=
CHAT_LIMITE_DIARIO=
# Registro y perfil (solo en el servidor, nunca NEXT_PUBLIC_*):
# CORREO_CONTACTO: a dónde se escribe para corregir datos o ejercer derechos (si falta, se usa GMAIL_USER).
# REGISTRO_SECRETO_IP: secreto del hash de la IP con que se cuentan los nombres rechazados y los reenvíos (la IP
#   no se guarda), y del hash del destinatario en registro_correos. Para que npm run correo:historial encuentre
#   los registros de producción, pon aquí el mismo valor que en Vercel (si falta en ambos, se usa la clave de servicio).
# CRON_SECRET: protege la tarea programada que limpia autorizaciones de tutores vencidas.
CORREO_CONTACTO=
REGISTRO_SECRETO_IP=
CRON_SECRET=
# Avisos de errores con Sentry (ver README, sección Avisos de errores). Vacíos: Sentry no se activa.
# Solo envía en producción y vistas previas de Vercel; en local y en las pruebas, nunca.
# SENTRY_DSN (servidor) y NEXT_PUBLIC_SENTRY_DSN (navegador): el DSN del proyecto en Sentry (no es secreto).
# SENTRY_TRACES_SAMPLE_RATE y NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE: fracción de trazas, de 0 a 0.1 (por defecto 0.05).
# SENTRY_AUTH_TOKEN, SENTRY_ORG y SENTRY_PROJECT: solo en Vercel, para subir los source maps. Sin ellos la compilación sigue.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
