NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Gym Assistant"
NEXT_PUBLIC_APP_VERSION="0.1.0"
DATA_DIR=./data
NEXT_PUBLIC_GYMLEAD_GYMLEADSUPABASE_URL=
NEXT_PUBLIC_GYMLEAD_GYMLEADSUPABASE_PUBLISHABLE_KEY=
GYMLEAD_SUPABASE_SERVICE_ROLE_KEY=
GYMLEAD_POSTGRES_URL=
# Correo: con GMAIL_USER y GMAIL_APP_PASSWORD se envía por Gmail; si faltan, por Resend.
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM=
# CHRONO: clave de Groq, modelo opcional y límite opcional de mensajes por cuenta y día.
GROQ_API_KEY=
GROQ_MODELO=
CHAT_LIMITE_DIARIO=
# Registro y perfil (solo en el servidor, nunca NEXT_PUBLIC_*):
# CORREO_CONTACTO: a dónde se escribe para corregir datos o ejercer derechos (si falta, se usa GMAIL_USER).
# REGISTRO_SECRETO_IP: secreto del hash de la IP con que se cuentan los nombres rechazados (la IP no se guarda).
# CRON_SECRET: protege la tarea programada que limpia autorizaciones de tutores vencidas.
CORREO_CONTACTO=
REGISTRO_SECRETO_IP=
CRON_SECRET=
