{
  "name": "gym-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/tokenVercel.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ver": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "db:migrar": "node --env-file=.env.local scripts/migrar.mjs",
    "db:verificar": "node --env-file=.env.local scripts/verificar-bd.mjs",
    "db:limpiar": "node --env-file=.env.local scripts/limpiar-prueba.mjs",
    "db:respaldar": "node --env-file-if-exists=.env.local scripts/respaldo/respaldar.mjs",
    "db:restaurar": "node --env-file-if-exists=.env.local scripts/respaldo/restaurar.mjs",
    "db:demo": "tsx --env-file=.env.local scripts/cargar-demo.ts",
    "probar:flujo": "tsx --env-file=.env.local scripts/probar-flujo.ts",
    "correo:historial": "tsx --env-file=.env.local scripts/correo-historial.ts",
    "correo:probar": "tsx --env-file=.env.local scripts/correo-probar.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/connect": "^2.5.2",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^11.11.11",
    "groq-sdk": "^1.6.0",
    "next": "^15.3.5",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.34.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vercel": "^64.5.0",
    "vitest": "^2.1.8"
  }
}
